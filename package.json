{
  "name": "poketracker",
  "private": true,
  "version": "2.0.4",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @poketracker/server & npm run dev -w @poketracker/web",
    "build": "npm run build -w @poketracker/web && npm run build -w @poketracker/server",
    "bundle": "node scripts/make-bundle.mjs",
    "validate:deploy": "node scripts/validate-deploy-templates.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b apps/web && tsc -p apps/server --noEmit && tsc -p packages/shared --noEmit",
    "test": "npm test -w @poketracker/shared -w @poketracker/server -w @poketracker/launcher -w @poketracker/web",
    "audit:printings": "tsx scripts/audit-printings.ts",
    "test:browser": "playwright test",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1-d1531a9.0.sha-d1531a9",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.65.0-alpha-2026-10-13",
    "@types/node": "^24.12.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "js-yaml": "^4.3.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.11"
  },
  "poketracker": {
    "minLauncher": "1.1.0"
  }
}
