# Keep registry download URLs out of package-lock.json. npm finds each tarball in whichever
# registry is configured (public npm, a managed feed, a mirror) and still verifies it against
# the recorded integrity hash. `npm run lockfile:check` enforces this in CI.
omit-lockfile-registry-resolved=true

# Fail the install on the wrong Node or npm instead of warning and breaking later. npm 10
# (Node 22) and npm 11 (Node 24) write the lockfile differently; see CONTRIBUTING.md.
engine-strict=true
